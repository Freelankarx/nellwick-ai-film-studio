# Supabase: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL, no trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud Console OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes). Never expose this to the browser.
TOKEN_ENCRYPTION_KEY=
