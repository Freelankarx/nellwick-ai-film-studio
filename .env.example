# Supabase project connection (Project URL + current API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional legacy-key fallbacks if your project dashboard only shows the old names:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public Studio origin. In Vercel Production use:
NEXT_PUBLIC_APP_URL=https://nellwick-ai-film-studio.vercel.app

# Google Auth Platform Personal mode / Web application OAuth client.
# Personal mode is restricted to the Google Account that created the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nellwick-ai-film-studio.vercel.app/api/drive/callback

# Generate a random 32-byte key (64 hexadecimal characters). Server only.
# Example: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
